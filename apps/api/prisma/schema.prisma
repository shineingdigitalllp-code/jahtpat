generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  owner
  manager
  staff
}

enum AdminStatus {
  pending
  active
  suspended
}

enum CouponType {
  flat
  percent
  free_delivery
}

enum CouponCategory {
  general
  bank
  wallet
  combo
}

enum BannerPlacement {
  home
  offers
}

enum OrderStatus {
  pending_payment
  placed
  preparing
  out_for_delivery
  delivered
  cancelled
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  cod
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model AdminUser {
  id                 String              @id @default(cuid())
  name               String              @db.VarChar(60)
  email              String              @unique
  passwordHash       String
  role               AdminRole           @default(staff)
  status             AdminStatus         @default(pending)
  mustChangePassword Boolean             @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  logs               ActivityLog[]
  walletTxns         WalletTransaction[]
}

model ActivityLog {
  id        Int       @id @default(autoincrement())
  adminId   String
  action    String    @db.VarChar(60)
  entity    String    @db.VarChar(30)
  entityId  String    @db.VarChar(64)
  meta      Json?
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

model WalletTransaction {
  id          Int       @id @default(autoincrement())
  userId      String
  adminId     String
  amountPaise Int
  reason      String    @db.VarChar(120)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       AdminUser @relation(fields: [adminId], references: [id])

  @@index([userId, createdAt])
}

model StoreSetting {
  id                     Int      @id @default(1)
  name                   String   @default("Jhatpat") @db.VarChar(60)
  phone                  String?  @db.VarChar(15)
  address                String?  @db.VarChar(191)
  isOpen                 Boolean  @default(true)
  etaMinutes             Int      @default(10)
  deliveryFeePaise       Int
  freeDeliveryAbovePaise Int
  minOrderPaise          Int      @default(0)
  lowStockThreshold      Int      @default(10)
  updatedAt              DateTime @updatedAt
}

model User {
  id           String              @id @default(cuid())
  name         String              @db.VarChar(60)
  mobile       String?             @unique @db.VarChar(10)
  email        String?             @unique
  passwordHash String?
  walletPaise  Int                 @default(0)
  googleId     String?             @unique
  isBlocked    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  addresses    Address[]
  cart         Cart?
  wishlist     Wishlist[]
  orders       Order[]
  walletTxns   WalletTransaction[]

  @@index([isBlocked, createdAt])
  @@index([createdAt])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @db.VarChar(30)
  line1     String
  line2     String?
  city      String  @db.VarChar(60)
  state     String  @db.VarChar(60)
  pincode   String  @db.VarChar(6)
  lat       Float?
  lng       Float?
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Category {
  id        Int        @id @default(autoincrement())
  parentId  Int?
  name      String     @db.VarChar(60)
  slug      String     @unique @db.VarChar(80)
  image     String
  featured  Boolean    @default(false)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  banners   Banner[]

  @@index([parentId, isActive])
}

model Product {
  id          Int            @id @default(autoincrement())
  categoryId  Int
  name        String         @db.VarChar(120)
  slug        String         @unique @db.VarChar(140)
  unit        String         @db.VarChar(30)
  subtitle    String         @db.VarChar(80)
  description String         @db.Text
  tag         String?        @db.VarChar(30)
  ratingAvg   Float          @default(0)
  ratingCount Int            @default(0)
  mrpPaise    Int
  pricePaise  Int
  stock       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  cartItems   CartItem[]
  wishlist    Wishlist[]
  orderItems  OrderItem[]

  @@index([categoryId, isActive])
  @@index([stock])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Banner {
  id         Int             @id @default(autoincrement())
  placement  BannerPlacement @default(home)
  categoryId Int?
  title      String          @db.VarChar(60)
  subtitle   String          @db.VarChar(120)
  ctaLabel   String          @default("Shop Now") @db.VarChar(20)
  image      String
  link       String
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
}

model Cart {
  id       String     @id @default(cuid())
  userId   String     @unique
  couponId Int?
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon   Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    CartItem[]
}

model CartItem {
  cartId    String
  productId Int
  qty       Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
}

model Wishlist {
  userId    String
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Coupon {
  id               Int            @id @default(autoincrement())
  code             String         @unique @db.VarChar(30)
  title            String         @db.VarChar(40)
  subtitle         String         @db.VarChar(60)
  image            String
  category         CouponCategory @default(general)
  sortOrder        Int            @default(0)
  type             CouponType
  value            Int
  minOrderPaise    Int            @default(0)
  maxDiscountPaise Int?
  validFrom        DateTime
  validTo          DateTime
  isActive         Boolean        @default(true)
  carts            Cart[]
}

model Order {
  id                String        @id @default(cuid())
  code              String        @unique @db.VarChar(12)
  userId            String
  addressId         String
  status            OrderStatus   @default(placed)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(pending)
  subtotalPaise     Int
  discountPaise     Int
  couponCode        String?       @db.VarChar(30)
  couponPaise       Int           @default(0)
  deliveryPaise     Int
  totalPaise        Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  refundedPaise     Int           @default(0)
  cancelledAt       DateTime?
  cancelReason      String?       @db.VarChar(120)
  adminNote         String?       @db.VarChar(255)
  createdAt         DateTime      @default(now())
  preparingAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  riderName         String?       @db.VarChar(60)
  riderPhone        String?       @db.VarChar(10)
  etaAt             DateTime?
  user              User          @relation(fields: [userId], references: [id])
  address           Address       @relation(fields: [addressId], references: [id])
  items             OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  orderId    String
  productId  Int
  name       String  @db.VarChar(120)
  unit       String  @db.VarChar(30)
  qty        Int
  pricePaise Int
  mrpPaise   Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}
